# ==========================================
# CIVICA Spring Boot Backend Environment Variables
# ==========================================

# Server Port (Render sets this automatically; default: 5000)
PORT=5000

# Database Configuration (MySQL)
# In production on Render/Railway/Aiven, replace with your cloud MySQL JDBC URL and credentials:
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/Civica?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root123

# Frontend URL (Vercel Production)
FRONTEND_URL=https://civica-sand-delta.vercel.app

# CORS Allowed Origins (Optional additional domains / wildcards)
CORS_ALLOWED_ORIGINS=https://*.vercel.app

# JWT Security
JWT_SECRET=civica_super_secret_jwt_key_2024
JWT_EXPIRATION=604800000

# Google OAuth 2.0 (From Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH2_REDIRECT_URI=https://civica-sand-delta.vercel.app/oauth-success

# AI Service (Optional Flask service)
AI_SERVICE_URL=http://127.0.0.1:5001

# File Upload Directory
FILE_UPLOAD_DIR=./uploads
